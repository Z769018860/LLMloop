{
  "kind": "smt_spgraph",
  "name": "dynamic_threshold_overlap",
  "parameters": ["n"],
  "parameter_bounds": {"n": [0, 100]},
  "state": {"x": 0, "i": 0},
  "loop_guard": "i < n",
  "paths": [
    {"id": "below", "when": "x < 5", "updates": {"x": "x+2", "i": "i+1"}},
    {"id": "above", "when": "x >= 5", "updates": {"x": "x-3", "i": "i+1"}}
  ]
}
