{
  "kind": "oscillation",
  "name": "dynamic_oscillation_and_progress",
  "parameters": ["n"],
  "state": {"x": 0, "i": 0, "y": 0},
  "phase_var": "x",
  "threshold": 5,
  "branches": {
    "below": {"x": "x + 2", "i": "i + 3", "y": "y + 1"},
    "at_or_above": {"x": "x - 5", "i": "i + 4", "y": "y + 2"}
  },
  "exit": {"var": "i", "op": "<", "bound": "n"}
}
