{
  "frontend": "typed_summary_portfolio",
  "source": "long f(int n){unsigned char x=0;long y=0;for(int i=0;i<n;i++){x++;y++;}return y+x;}",
  "parameter_bounds": {"n": [0, 1000000000]},
  "inputs": {"n": 1000000000},
